{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://1200km.com/schemas/article-catalog.schema.json",
  "title": "1200km article archive catalogue",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id", "title", "summary", "published_at", "updated_at", "year", "category",
      "images", "code_blocks", "slug", "local_path", "source_url", "cover_image",
      "canonical_url", "canonical_owner", "preferred_canonical_url",
      "original_publication_url", "original_publication_platform",
      "canonical_migration_status", "external_canonical_verified",
      "external_canonical_verified_at", "migration_note", "source_platform",
      "source_repository", "collection_tier"
    ],
    "properties": {
      "id": {"type": "string", "pattern": "^[0-9a-f]{12,}$"},
      "title": {"type": "string", "minLength": 1},
      "summary": {"type": "string"},
      "published_at": {"type": "string", "format": "date"},
      "updated_at": {"type": "string", "format": "date"},
      "year": {"type": "string", "pattern": "^[0-9]{4}$"},
      "category": {"type": "string", "minLength": 1},
      "images": {"type": "integer", "minimum": 0},
      "code_blocks": {"type": "integer", "minimum": 0},
      "slug": {"type": "string", "minLength": 1},
      "local_path": {"type": "string", "minLength": 1},
      "source_url": {"type": "string", "format": "uri"},
      "cover_image": {"type": "string"},
      "canonical_url": {"type": "string", "format": "uri"},
      "canonical_owner": {"enum": ["1200km.com", "external-publication"]},
      "preferred_canonical_url": {"type": "string", "format": "uri"},
      "original_publication_url": {"type": "string", "format": "uri"},
      "original_publication_platform": {"type": "string", "minLength": 1},
      "canonical_migration_status": {"enum": ["local-confirmed", "external-still-canonical", "migration-pending", "external-uncontrolled", "local-noindex", "historical-copy"]},
      "external_canonical_verified": {"type": "boolean"},
      "external_canonical_verified_at": {"type": ["string", "null"], "format": "date"},
      "migration_note": {"type": "string", "minLength": 1},
      "source_platform": {"type": "string", "minLength": 1},
      "source_repository": {"const": "anpa1200/medium-blog-navigation"},
      "collection_tier": {"enum": ["core", "reference", "archive"]}
    }
  }
}
